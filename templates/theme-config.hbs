<div class="heroes-theme-form standard-form">
  {{!-- ApplicationV2 requires each template part to render exactly one root element. --}}
  <fieldset>
    <legend>{{localize "HEROESTHEME.Config.Bridge"}}</legend>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Settings.BridgeUrl.Name"}}</label>
      <input type="url" name="bridge.url" value="{{bridge.url}}" placeholder="wss://bot.example.com">
      <p class="hint">{{localize "HEROESTHEME.Settings.BridgeUrl.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Settings.BridgeToken.Name"}}</label>
      <input type="password" name="bridge.token" value="{{bridge.token}}" autocomplete="off">
      <p class="hint">{{localize "HEROESTHEME.Settings.BridgeToken.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "HEROESTHEME.Config.Players"}}</legend>
    <table class="heroes-theme-players">
      <thead>
        <tr>
          <th>{{localize "HEROESTHEME.Config.Player"}}</th>
          <th>{{localize "HEROESTHEME.Config.DiscordId"}}</th>
          <th>{{localize "HEROESTHEME.Config.Theme"}}</th>
          <th>{{localize "HEROESTHEME.Config.Enabled"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
        <tr>
          <td>{{name}}</td>
          <td>
            <input type="text" name="users.{{id}}.discordUserId" value="{{discordUserId}}"
                   inputmode="numeric" pattern="\d{15,22}" placeholder="123456789012345678">
          </td>
          <td>
            <select name="users.{{id}}.themeId">
              <option value="">{{localize "HEROESTHEME.Config.NoTheme"}}</option>
              {{selectOptions ../sounds selected=themeId}}
            </select>
          </td>
          <td><input type="checkbox" name="users.{{id}}.enabled" {{checked enabled}}></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </fieldset>

  <fieldset>
    <legend>{{localize "HEROESTHEME.Config.Triggers"}}</legend>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Config.StartDebounce"}}</label>
      <input type="number" name="engine.startDebounceMs" value="{{engine.startDebounceMs}}" min="0" step="100">
    </div>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Config.StopHold"}}</label>
      <input type="number" name="engine.stopHoldMs" value="{{engine.stopHoldMs}}" min="0" step="100">
    </div>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Config.Cooldown"}}</label>
      <input type="number" name="engine.cooldownMs" value="{{engine.cooldownMs}}" min="0" step="100">
    </div>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Config.Concurrency"}}</label>
      <select name="engine.concurrency">
        {{selectOptions concurrencyChoices selected=engine.concurrency localize=true}}
      </select>
    </div>
    <div class="form-group">
      <label>{{localize "HEROESTHEME.Config.Volume"}}</label>
      <input type="number" name="engine.defaultVolume" value="{{engine.defaultVolume}}" min="0" max="1" step="0.05">
    </div>
  </fieldset>

  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "HEROESTHEME.Config.Save"}}</button>
  </footer>
</div>
